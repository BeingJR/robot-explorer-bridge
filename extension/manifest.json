{
  "manifest_version": 3,
  "name": "Proxie Robot Local Bridge",
  "version": "1.1",
  "description": "Connects the hosted Robot Explorer to local Python.",

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://beingjr.github.io/robot-explorer-bridge/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "host_permissions": ["https://beingjr.github.io/robot-explorer-bridge/*"]
}
